model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Transformar Arquivo de BaseDados'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Transformar Arquivo de BaseDados\Consultas Auxiliares'

	annotation PBI_QueryGroupOrder = 0

/// Erros nas consultas que foram carregadas em 13/09/2026 20:57:46.
queryGroup 'Erros na Consulta - 13/09/2026 20:57:46'

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","MCP-PBIModeling"]

annotation PBI_QueryOrder = ["BaseDados","Arquivo de Amostra","Parâmetro1","Transformar o Arquivo de Exemplo","Transformar Arquivo","Funcionarios","Calendario","Erros em Funcionarios"]

ref table BaseDados
ref table Funcionarios
ref table Calendario
ref table _Medidas

ref cultureInfo pt-BR

